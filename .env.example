# Public Supabase values. Never use a service-role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Exact public app origin. HTTPS is required except for local development.
APP_ORIGIN=http://localhost:3000

# Supabase Auth UUID of the one account allowed to connect the channel.
OWNER_USER_ID=

# Server-only values. Never prefix these with NEXT_PUBLIC_.
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 random bytes encoded as standard Base64. Generate locally with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Vercel Cron authentication. Generate a long random value and keep it server-only.
CRON_SECRET=

# Optional server-only MCP bearer authentication for Codex/GPT connectors.
MCP_SECRET=

# Optional provider-agnostic AI adapter. Use an OpenAI-compatible endpoint only
# when separately configured; leave blank to keep AI explicitly unavailable.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Internal video rendering, artifact storage, worker, and YouTube upload
# settings were retired. Existing hosting variables can be removed after the
# archived records have been reviewed; they are no longer read by the app.
